NODE_ENV=production
PORT=3000
APP_NAME=DocFlow
APP_BASE_URL=https://your-service.onrender.com
TRUST_PROXY=false
DATABASE_URL=
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES=12h
TRIAL_DAYS=14
MAX_FILE_MB=25
MAX_BATCH_FILES=20
RATE_LIMIT=900
AUTH_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=120
PGSSL_DISABLE=false
PGPOOL_MAX=20
WORKER_INTERVAL_MS=2000

# AI extraction (optional but recommended)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000

# OCR for scanned PDFs/images
OCR_API_URL=https://api.ocr.space/parse/image
OCR_API_KEY=
OCR_LANGUAGE=eng

# Durable object storage (REQUIRED for serious production)
# Works with AWS S3 and S3-compatible providers such as Cloudflare R2 / Backblaze B2.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SSE=

# SMTP notifications / invitations / password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_DEFAULT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
STRIPE_DEFAULT_PLAN=business

# Paystack subscriptions/payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=
PAYSTACK_DEFAULT_PLAN=business

# OIDC / SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# SCIM provisioning
SCIM_TOKEN_SECRET=

# Optional fallback webhook HMAC secret
WEBHOOK_SIGNING_SECRET=
ALLOW_PRIVATE_WEBHOOKS=false
WEBHOOK_TIMEOUT_MS=10000
CURRENCY=NGN

# Optional operational controls
BACKUP_STATUS=
METRICS_TOKEN=
